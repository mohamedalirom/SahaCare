# SahaCare - Configuration de l'environnement
# Obtenez une clé API Gemini gratuite sur Google AI Studio : https://aistudio.google.com/
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# Saha Intelligence (Suivi de santé) : sur le web, le modèle Hugging Face tourne dans le navigateur, rien à configurer.
# Facultatif : adresse d'un serveur de modèle compatible « chat completions » (ex. Space Hugging Face)
HF_SPACE_URL=
# Autre possibilité (crédits payants) : jeton Hugging Face, à créer sur https://huggingface.co/settings/tokens
# (type "Fine-grained", permission "Make calls to Inference Providers")
HF_TOKEN=YOUR_HUGGING_FACE_TOKEN_HERE
# Facultatif : nom du modèle
# HF_MODEL=
